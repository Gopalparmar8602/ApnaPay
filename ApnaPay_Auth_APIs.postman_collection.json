{
  "info": {
    "_postman_id": "apnapay-complete-auth-apis-v1",
    "name": "ApnaPay - Complete Auth APIs (17 APIs)",
    "description": "All 17 Authentication APIs for ApnaPay (8 Customer + 9 Admin) with automated variable passing and tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "customer@example.com",
      "type": "string"
    },
    {
      "key": "userPhone",
      "value": "9876543210",
      "type": "string"
    },
    {
      "key": "userPassword",
      "value": "Password123@",
      "type": "string"
    },
    {
      "key": "userOtp",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userResetToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "adminapnapay@gmail.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Admin123@",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminOtp",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminResetToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Customer Auth (8 APIs)",
      "item": [
        {
          "name": "1. Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.otp) {",
                  "    pm.collectionVariables.set('userOtp', res.otp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/send-otp" }
          }
        },
        {
          "name": "2. Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"otp\": \"{{userOtp}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/verify-otp" }
          }
        },
        {
          "name": "3. Register Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Gopal Parmar\",\n  \"phone\": \"{{userPhone}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register" }
          }
        },
        {
          "name": "4. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('userToken', res.token);",
                  "if (res.refreshToken) pm.collectionVariables.set('userRefreshToken', res.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "5. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('userToken', res.token);",
                  "if (res.refreshToken) pm.collectionVariables.set('userRefreshToken', res.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{userRefreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh" }
          }
        },
        {
          "name": "6. Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{userRefreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/logout" }
          }
        },
        {
          "name": "7. Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.resetToken) pm.collectionVariables.set('userResetToken', res.resetToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password" }
          }
        },
        {
          "name": "8. Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{userResetToken}}\",\n  \"newPassword\": \"NewPassword456@\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/reset-password" }
          }
        }
      ]
    },
    {
      "name": "2. Admin Auth (9 APIs)",
      "item": [
        {
          "name": "1. Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.accessToken) pm.collectionVariables.set('adminToken', res.data.accessToken);",
                  "if (res.data?.refreshToken) pm.collectionVariables.set('adminRefreshToken', res.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/auth/login" }
          }
        },
        {
          "name": "2. Admin Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/auth/profile" }
          }
        },
        {
          "name": "3. Admin Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.accessToken) pm.collectionVariables.set('adminToken', res.data.accessToken);",
                  "if (res.data?.refreshToken) pm.collectionVariables.set('adminRefreshToken', res.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/auth/refresh" }
          }
        },
        {
          "name": "4. Admin Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"AdminNewSecret789@\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/auth/change-password" }
          }
        },
        {
          "name": "5. Admin Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.devOtp) pm.collectionVariables.set('adminOtp', res.devOtp);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"purpose\": \"login\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/auth/send-otp" }
          }
        },
        {
          "name": "6. Admin Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"otp\": \"{{adminOtp}}\",\n  \"purpose\": \"login\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/auth/verify-otp" }
          }
        },
        {
          "name": "7. Admin Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.resetToken) pm.collectionVariables.set('adminResetToken', res.resetToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/auth/forgot-password" }
          }
        },
        {
          "name": "8. Admin Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{adminResetToken}}\",\n  \"newPassword\": \"AdminPassword123@\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/auth/reset-password" }
          }
        },
        {
          "name": "9. Admin Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/auth/logout" }
          }
        }
      ]
    }
  ]
}
