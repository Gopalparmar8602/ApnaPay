PORT=5000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=payment_app

# Customer JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Admin JWT Secrets
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here
ADMIN_JWT_REFRESH_SECRET=your_admin_jwt_refresh_secret_key_here

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# Application Environment
NODE_ENV=development

# OTP Security & Verification Timing Policies
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRES_MINUTES=15

# SMTP Email Service Configuration (Nodemailer / Gmail / Custom SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password_or_app_password
EMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_FROM="ApnaPay Security" <your_email@gmail.com>

# SMS Gateway Configuration
# Supported providers: 'msg91' | 'twilio' | 'fast2sms' | 'generic'
SMS_PROVIDER=msg91
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=APNPAY
SMS_TEMPLATE_ID=your_sms_template_id_here

# Provider-Specific SMS Credentials (Optional / Direct)
# MSG91
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here
MSG91_FLOW_ID=your_msg91_flow_id_here
MSG91_SENDER_ID=APNPAY

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here

# Fast2SMS (Quick OTP API)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Generic HTTP SMS Gateway / Webhook
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# Banking Verification & Encryption Settings
BANK_VERIFICATION_PROVIDER=demo
BANK_ENCRYPTION_SECRET=your_bank_encryption_secret_aes256_here
